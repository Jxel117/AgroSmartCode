# ============================================================
# AgroSmart - Microservicio de Auditoría
# Copiar a .env y ajustar valores
# ============================================================

# IMPORTANTE: Este JWT_SECRET debe ser IDÉNTICO al de AgroSmart
JWT_SECRET=Clavesupersecreta1234567890
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# RabbitMQ
RABBITMQ_USER=audit_user
RABBITMQ_PASS=audit_pass

# PostgreSQL de auditoría
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit_secret
AUDIT_DB_NAME=auditoria_db

DB_HOST=localhost
DB_PORT=5434
DB_USER=audit
DB_PASSWORD=audit_secret
DB_NAME=auditoria_db
